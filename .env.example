# Bu dosyayi ".env" olarak kopyala ve degerleri kendine gore degistir.

# Sunucunun calisacagi port
PORT=3000

# Oturum (session) sifreleme anahtari - rastgele, uzun bir metin yaz
SESSION_SECRET=bu-anahtari-degistir-12345

# Ilk admin hesabi (sadece veritabani ilk kurulurken bir kere kullanilir)
ADMIN_USER=admin
ADMIN_PASS=admin123
